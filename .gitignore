# Python
.venv/
.venv-brain/
.venv-tts/
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Build output.  firmware/sdkconfig is generated by ESP-IDF into the project
# directory and is profile-specific; build.sh gives each profile its own copy
# under its build directory, and a stray one here would win over both.
firmware/host/build/
firmware/build/
firmware/build-debug/
firmware/sdkconfig
firmware/sdkconfig.old
build/
*.o
*.a

# Runtime state, never committed
run/
data/
logs/*.jsonl
logs/gates/*.jsonl

# Local machine config: box URL, calibration, anything site-specific
config/robot.toml

# Local host investigation notes (contain home network details) — never publish
rasberrypi.md
raspberrypi.md
*.local.md

# Editor and OS
.DS_Store
*.swp

# firmware/build.sh: arduino-cli core, toolchains and libraries (about 2.5 GB)
firmware/.cache/
