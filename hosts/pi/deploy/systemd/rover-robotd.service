[Unit]
Description=rover robotd — the only writer of the motion controller port
Documentation=https://github.com/tedthizzy/bot/blob/main/ARCHITECTURE.md
# Not Requires= on the device: robotd retries open() every [link]
# open_retry_ms, so an unwired or unflashed MCU is a state it sits in rather
# than a start failure. That is the same behaviour deploy step 10 leaves
# standing, and Restart=always must not turn it into a restart loop.

[Service]
Type=notify
NotifyAccess=main
User=rover-robotd
Group=rover
WorkingDirectory=/opt/rover
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rover/.venv/bin/rover-robotd --config /opt/rover/config/robot.toml

Restart=always
RestartSec=1
# A real restart loop must stay visible rather than being rate-limited into
# looking like a healthy service.
StartLimitIntervalSec=0

# Pinged unconditionally from the main loop while it is scheduling — liveness,
# not readiness. Gating the ping on fresh telemetry would restart-loop robotd
# every 10 s whenever the MCU is unplugged, which is its state until deploy
# step 10. Readiness is already gated by T0 and the arm policy, and kill -STOP
# still trips this.
WatchdogSec=10

# /run/rover is created by /etc/tmpfiles.d/rover.conf as 0770 rover:rover, not
# by RuntimeDirectory=, because four units with four users share it and a
# robotd restart must not delete brain's and cam's sockets.
ReadWritePaths=/run/rover /data/logs

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# §9's first remedies if G3a measures p99 V inter-frame gap above 100 ms.
# Deliberately not on by default: they are a response to a measurement, and the
# Setpoint{valid_until} ownership rule (4.2) is what makes them safe to apply.
# CPUAffinity=3
# Nice=-5

[Install]
WantedBy=rover.target
