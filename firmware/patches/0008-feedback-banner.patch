     bot_driveMotors();  // stop now under the new flags, not at the next host command
   }
 }
+
+
+// --- feedback helpers ----------------------------------------------------
+
+// Round a float to three decimals as a double, so ArduinoJson prints 0.3 rather
+// than the widened float 0.300000012. Host units carry no more precision than
+// the 8-bit duty anyway.
+double bot_round3(float v) {
+  return lroundf(v * 1000.0f) / 1000.0;
+}
+
+// {"T":1006,"fw":"bot-wr-1","hb_ms":300,"cap":0.3,"proto":1}
+// hb_ms and cap are the compiled constants, not the current settings.
+void bot_printBanner() {
+  jsonInfoHttp.clear();
+  jsonInfoHttp["T"] = FEEDBACK_BOT_BANNER;
+  jsonInfoHttp["fw"] = BOT_FW_TAG;
+  jsonInfoHttp["hb_ms"] = BOT_HEARTBEAT_MS;
+  jsonInfoHttp["cap"] = bot_round3(BOT_POWER_CAP);
+  jsonInfoHttp["proto"] = BOT_PROTO;
+  String bannerJsonString;
+  serializeJson(jsonInfoHttp, bannerJsonString);
+  Serial.println(bannerJsonString);
+}
