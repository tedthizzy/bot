 void changeHeartBeatDelay(int inputCmd) {
-  HEART_BEAT_DELAY = inputCmd;
+  // bot: only tighten. Values above BOT_HEARTBEAT_MS are ignored so nothing on the
+  // wire can weaken the stop. Values <= 0 are ignored too: heartBeatCtrl()
+  // compares unsigned long against this int, so a negative delay would never
+  // fire and a zero would stop the motors right after every command.
+  if (inputCmd > 0 && inputCmd <= BOT_HEARTBEAT_MS) {
+    HEART_BEAT_DELAY = inputCmd;
+  }
 }
 
