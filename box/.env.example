# Variable NAMES only. Copy to box/.env (gitignored) and fill it in there, or
# export these in your shell. Never commit a value: this repo is public and
# deploy/check-secrets.sh fails the build if a value lands in a tracked file.
#
#   cp box/.env.example box/.env
#   docker compose --env-file box/.env -f docker/compose.box.yml up -d vllm

# Hugging Face token, for gated or rate-limited model downloads. Not needed for
# a public repo weight, and not needed at all once the cache is warm.
HF_TOKEN=

# Bearer token the box requires and brain sends. Leave empty on a trusted LAN.
# config/robot.toml names this variable in [box] api_key_env; it never holds the
# value itself.
ROVER_BOX_API_KEY=

# The rover's own view of where the box is, e.g. http://<box-host>:8000/v1.
# Overrides [box] url without editing a tracked file (A33). Set it on the Pi,
# not on the box.
ROVER__BOX__URL=

# --- compose knobs, all with defaults in docker/compose.box.yml -------------
# Exact 0.28.x patch; pin the digest before build day.
VLLM_TAG=
# A15's pick, or one of its two fallbacks.
BOX_MODEL=
# 0.85 normally; 0.75 in the same change that starts the speech profile.
BOX_GPU_UTIL=
# Interface to publish on. 0.0.0.0 by default; 127.0.0.1 to keep it local.
BOX_BIND=
# Host directory for the Hugging Face cache, so a redeploy is not a re-download.
HF_CACHE=
# Speech profile only, dark until G3b.
WHISPER_TAG=
WHISPER_DATA=
KOKORO_TAG=
